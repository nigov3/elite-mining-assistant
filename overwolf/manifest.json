{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Elite Dangerous Companion",
    "author": "nigov3",
    "version": "0.2.0",
    "description": "Elite Dangerous mining reference overlay",
    "minimum-overwolf-version": "0.170.0",
    "icon": "icon.png"
  },
  "permissions": [
    "Hotkeys",
    "GameInfo"
  ],
  "data": {
    "start_window": "background",
    "game_targeting": {
      "type": "all"
    },
    "hotkeys": {
      "toggle_mining": {
        "title": "Показать/скрыть Mining Assistant",
        "action-type": "custom",
        "default": "Ctrl+Shift+M"
      }
    },
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      },
      "overlay": {
        "file": "overlay.html",
        "in_game_only": true,
        "transparent": true,
        "resizable": true,
        "keep_window_location": true,
        "size": {
          "width": 980,
          "height": 780
        },
        "min_size": {
          "width": 420,
          "height": 340
        }
      }
    }
  }
}